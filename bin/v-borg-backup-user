#!/bin/bash
# info: backup user with borg incremental
# options: USER [NOTIFY]
#
# This command creates an incremental backup of a user using Borg Backup.
# It backs up the user's home directory, databases, and myVesta configuration.

#----------------------------------------------------------#
#                Variable & Argument Definition            #
#----------------------------------------------------------#

# Arguments
user=$1
notify=${2-no}

# Source shared functions
if [ -f "/usr/local/vesta/func/borg.sh" ]; then
    source /usr/local/vesta/func/borg.sh
else
    # Try local development path
    SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
    NEW_BORG_DIR="$(dirname "$SCRIPT_DIR")"
    source "$NEW_BORG_DIR/func/borg.sh"
fi

# Source myVesta environment
source /etc/profile.d/vesta.sh 2>/dev/null || source /etc/profile

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_root
check_borg_installed
source_borg_config
ensure_log_dir

# Check arguments
if [ -z "$user" ]; then
    echo "Usage: v-borg-backup-user USER [NOTIFY]"
    echo "Error: USER argument is required"
    exit 1
fi

# Check if user exists
if ! check_user_exists "$user"; then
    echo "Error: User '$user' does not exist"
    exit 1
fi

# Check if user is suspended
if check_user_suspended "$user"; then
    echo "User '$user' is suspended, skipping backup"
    exit 0
fi

# Check if user is in excluded list
if [[ ",$EXCLUDED_USERS," == *",$user,"* ]]; then
    echo "User '$user' is in excluded list, skipping backup"
    exit 0
fi

# Load per-user config
if ! load_user_borg_config "$user"; then
    echo "Error: Failed to load per-user config for $user"
    exit 1
fi

# Check if backup is enabled for this user
if [ "$BORG_BACKUP_ENABLED" = "no" ]; then
    echo "User '$user' has backups disabled in per-user config, skipping backup"
    exit 0
fi

#----------------------------------------------------------#
#                    Backup Execution                      #
#----------------------------------------------------------#

START_TIME=$(date +%s)
ARCHIVE_DATE=$(get_archive_date)
LOG_FILE="$LOG_DIR/backup-user-$user-$ARCHIVE_DATE.log"

echo "$(get_timestamp) Starting backup for user: $user" | tee -a "$LOG_FILE"
echo "$(get_timestamp) Backup mode: $BACKUP_MODE" | tee -a "$LOG_FILE"

# Build repository paths
USER_REPO=$(build_borg_repo_path "user" "$user")
DB_REPO=$(build_borg_repo_path "db" "$user")
VESTA_REPO=$(build_borg_repo_path "vesta" "")  # Shared repo, no user identifier

echo "$(get_timestamp) User repository: $USER_REPO" | tee -a "$LOG_FILE"
echo "$(get_timestamp) DB repository: $DB_REPO" | tee -a "$LOG_FILE"
echo "$(get_timestamp) Vesta repository: $VESTA_REPO" | tee -a "$LOG_FILE"

# Initialize repositories if needed
init_repo_if_needed "$USER_REPO" >> "$LOG_FILE" 2>&1
init_repo_if_needed "$DB_REPO" >> "$LOG_FILE" 2>&1
init_repo_if_needed "$VESTA_REPO" >> "$LOG_FILE" 2>&1

# Remote repos for both+borg (independent backup, not rsync mirror)
if [ "$BACKUP_MODE" = "both" ] && [ "$REMOTE_SYNC_METHOD" = "borg" ]; then
    _SAVED_BACKUP_MODE="$BACKUP_MODE"
    BACKUP_MODE="remote"
    REMOTE_USER_REPO=$(build_borg_repo_path "user" "$user")
    REMOTE_DB_REPO=$(build_borg_repo_path "db" "$user")
    REMOTE_VESTA_REPO=$(build_borg_repo_path "vesta" "")
    BACKUP_MODE="$_SAVED_BACKUP_MODE"
    echo "$(get_timestamp) Remote user repository: $REMOTE_USER_REPO" | tee -a "$LOG_FILE"
    echo "$(get_timestamp) Remote DB repository: $REMOTE_DB_REPO" | tee -a "$LOG_FILE"
    echo "$(get_timestamp) Remote vesta repository: $REMOTE_VESTA_REPO" | tee -a "$LOG_FILE"
    init_repo_if_needed "$REMOTE_USER_REPO" >> "$LOG_FILE" 2>&1
    init_repo_if_needed "$REMOTE_DB_REPO" >> "$LOG_FILE" 2>&1
    init_repo_if_needed "$REMOTE_VESTA_REPO" >> "$LOG_FILE" 2>&1
fi

#----------------------------------------------------------#
#                Backup User Home Directory                #
#----------------------------------------------------------#

echo "$(get_timestamp) ========== BACKING UP USER HOME DIRECTORY ==========" | tee -a "$LOG_FILE"

# Build exclusion arguments
EXCLUDE_ARGS=$(build_user_exclude_args "$user")

# Create backup archive
ARCHIVE_NAME="$ARCHIVE_DATE"

echo "$(get_timestamp) Creating archive: $USER_REPO::$ARCHIVE_NAME" | tee -a "$LOG_FILE"

eval borg create \
    $OPTIONS_CREATE \
    $EXCLUDE_ARGS \
    "$USER_REPO::$ARCHIVE_NAME" \
    "$HOME_DIR/$user" \
    2>&1 | tee -a "$LOG_FILE"
BORG_EXIT=${PIPESTATUS[0]}
if borg_ok "$BORG_EXIT"; then
    echo "$(get_timestamp) Home directory backup completed successfully" | tee -a "$LOG_FILE"
    # Prune old archives only when backup succeeded
    echo "$(get_timestamp) Pruning old archives..." | tee -a "$LOG_FILE"
    borg prune $OPTIONS_PRUNE "$USER_REPO" 2>&1 | tee -a "$LOG_FILE"
    compact_repo_if_supported "$USER_REPO" >> "$LOG_FILE" 2>&1
else
    echo "$(get_timestamp) Error: Home directory backup failed (exit $BORG_EXIT)" | tee -a "$LOG_FILE"
    echo "$(get_timestamp) Skipping prune because backup failed" | tee -a "$LOG_FILE"
    BACKUP_FAILED=1
fi

#----------------------------------------------------------#
#                Backup myVesta Configuration              #
#----------------------------------------------------------#

echo "$(get_timestamp) ========== BACKING UP MYVESTA CONFIGURATION ==========" | tee -a "$LOG_FILE"

# Backup user's myVesta data
VESTA_USER_DIR="$VESTA_DIR/data/users/$user"

if [ -d "$VESTA_USER_DIR" ]; then
    # Vesta archive name format: USER-ARCHIVE_NAME (to allow multiple users in shared repo)
    VESTA_ARCHIVE_NAME="$user-$ARCHIVE_NAME"
    echo "$(get_timestamp) Creating archive: $VESTA_REPO::$VESTA_ARCHIVE_NAME" | tee -a "$LOG_FILE"
    
    borg create \
        $OPTIONS_CREATE \
        "$VESTA_REPO::$VESTA_ARCHIVE_NAME" \
        "$VESTA_USER_DIR" \
        2>&1 | tee -a "$LOG_FILE"
    BORG_EXIT=${PIPESTATUS[0]}
    if borg_ok "$BORG_EXIT"; then
        echo "$(get_timestamp) myVesta config backup completed successfully" | tee -a "$LOG_FILE"
        # Prune old vesta archives only when backup succeeded
        borg prune $OPTIONS_PRUNE "$VESTA_REPO" 2>&1 | tee -a "$LOG_FILE"
        compact_repo_if_supported "$VESTA_REPO" >> "$LOG_FILE" 2>&1
    else
        echo "$(get_timestamp) Error: myVesta config backup failed (exit $BORG_EXIT)" | tee -a "$LOG_FILE"
        echo "$(get_timestamp) Skipping prune because backup failed" | tee -a "$LOG_FILE"
        BACKUP_FAILED=1
    fi
fi

#----------------------------------------------------------#
#                Backup Databases                          #
#----------------------------------------------------------#

echo "$(get_timestamp) ========== BACKING UP DATABASES ==========" | tee -a "$LOG_FILE"

DB_COUNT=0
DATABASES=$(get_user_mysql_databases "$user")

# Clean up stale dump temp files from interrupted runs (older than 1 day)
DUMP_TMP_DIR="$BACKUP_DIR/tmp"
mkdir -p "$DUMP_TMP_DIR"
find "$DUMP_TMP_DIR" -name '*.sql' -mtime +1 -delete 2>/dev/null

# Large WP/InnoDB dumps need raised packet + timeouts (Error 2013 otherwise).
# Raise GLOBAL temporarily, then restore sysadmin values (also on unexpected exit).
if [ -n "$DATABASES" ]; then
    prepare_mysql_for_large_dump 2>&1 | tee -a "$LOG_FILE"
    trap 'restore_mysql_after_large_dump 2>&1 | tee -a "$LOG_FILE"' EXIT

    while IFS= read -r database; do
        if [ -z "$database" ]; then
            continue
        fi
        
        DB_ARCHIVE_NAME="$database-$ARCHIVE_DATE"
        echo "$(get_timestamp) Backing up database: $database" | tee -a "$LOG_FILE"

        # Always dump to a local temp file first, then feed borg.
        # Piping mysqldump|borg over a slow remote keeps the MySQL connection open for
        # the whole upload and triggers Error 2013 on large DBs (8GB+ / huge wp_options).
        DUMP_FILE=$(mktemp "$DUMP_TMP_DIR/${database}.XXXXXX.sql")
        mysqldump_to_file "$database" "$DUMP_FILE" 2>>"$LOG_FILE"
        DUMP_EXIT=$?
        if [ "$DUMP_EXIT" -ne 0 ]; then
            echo "$(get_timestamp) Error: mysqldump failed for database $database (exit $DUMP_EXIT)" | tee -a "$LOG_FILE"
            BACKUP_FAILED=1
            rm -f "$DUMP_FILE"
            continue
        fi

        borg create $OPTIONS_CREATE "$DB_REPO::$DB_ARCHIVE_NAME" - < "$DUMP_FILE" 2>&1 | tee -a "$LOG_FILE"
        BORG_EXIT=${PIPESTATUS[0]}
        if borg_ok "$BORG_EXIT"; then
            echo "$(get_timestamp) Database $database backed up successfully" | tee -a "$LOG_FILE"
            ((DB_COUNT++))
            borg prune $OPTIONS_PRUNE --glob-archives "${database}-*" "$DB_REPO" 2>&1 | tee -a "$LOG_FILE"
            compact_repo_if_supported "$DB_REPO" >> "$LOG_FILE" 2>&1
        else
            echo "$(get_timestamp) Error: borg create failed for database $database (exit $BORG_EXIT)" | tee -a "$LOG_FILE"
            BACKUP_FAILED=1
        fi

        # Independent remote borg copy when both+borg (same dump file, no second mysqldump)
        if [ "$BACKUP_MODE" = "both" ] && [ "$REMOTE_SYNC_METHOD" = "borg" ]; then
            borg create $OPTIONS_CREATE "$REMOTE_DB_REPO::$DB_ARCHIVE_NAME" - < "$DUMP_FILE" 2>&1 | tee -a "$LOG_FILE"
            REMOTE_BORG_EXIT=${PIPESTATUS[0]}
            if borg_ok "$REMOTE_BORG_EXIT"; then
                echo "$(get_timestamp) Database $database remote backup completed successfully" | tee -a "$LOG_FILE"
                borg prune $OPTIONS_PRUNE --glob-archives "${database}-*" "$REMOTE_DB_REPO" 2>&1 | tee -a "$LOG_FILE"
                compact_repo_if_supported "$REMOTE_DB_REPO" >> "$LOG_FILE" 2>&1
            else
                echo "$(get_timestamp) ERROR: remote borg create failed for database $database (exit $REMOTE_BORG_EXIT)" | tee -a "$LOG_FILE"
                SYNC_FAILED=1
            fi
        fi

        rm -f "$DUMP_FILE"
    done <<< "$DATABASES"
    
    echo "$(get_timestamp) Total databases backed up: $DB_COUNT" | tee -a "$LOG_FILE"

    restore_mysql_after_large_dump 2>&1 | tee -a "$LOG_FILE"
    trap - EXIT
else
    echo "$(get_timestamp) No databases found for user $user" | tee -a "$LOG_FILE"
fi

#----------------------------------------------------------#
#                Backup Summary                            #
#----------------------------------------------------------#

END_TIME=$(date +%s)
RUNTIME=$((END_TIME - START_TIME))
RUNTIME_MIN=$((RUNTIME / 60))

if [ $RUNTIME_MIN -lt 1 ]; then
    RUNTIME_MIN=1
fi

echo "$(get_timestamp) ========== BACKUP SUMMARY ==========" | tee -a "$LOG_FILE"
echo "$(get_timestamp) User: $user" | tee -a "$LOG_FILE"
echo "$(get_timestamp) Archive date: $ARCHIVE_DATE" | tee -a "$LOG_FILE"
echo "$(get_timestamp) Databases backed up: $DB_COUNT" | tee -a "$LOG_FILE"
echo "$(get_timestamp) Runtime: $RUNTIME_MIN minute(s)" | tee -a "$LOG_FILE"

#----------------------------------------------------------#
#                Sync to Remote (if both mode)              #
#----------------------------------------------------------#

if [ "$BACKUP_MODE" = "both" ]; then
    if [ "$REMOTE_SYNC_METHOD" = "rsync" ] && [ -z "$BACKUP_FAILED" ]; then
        echo "$(get_timestamp) ========== SYNCING TO REMOTE SERVER ==========" | tee -a "$LOG_FILE"
        
        # Create remote directory structure (required for rsync - some SFTP/Storage Box don't create nested dirs)
        echo "$(get_timestamp) Ensuring remote directories exist..." | tee -a "$LOG_FILE"
        REMOTE_MKDIR_CMD="mkdir -p ${REMOTE_BACKUP_DIR}/home/$user ${REMOTE_BACKUP_DIR}/db/$user ${REMOTE_BACKUP_DIR}/vesta"
        if [ -n "$REMOTE_BACKUP_PASSWORD" ]; then
            SSHPASS="$REMOTE_BACKUP_PASSWORD" sshpass -e ssh -p "$REMOTE_BACKUP_PORT" -o StrictHostKeyChecking=no "$REMOTE_BACKUP_SSH_TARGET" "$REMOTE_MKDIR_CMD" >> "$LOG_FILE" 2>&1
        else
            ssh -p "$REMOTE_BACKUP_PORT" -o StrictHostKeyChecking=no "$REMOTE_BACKUP_SSH_TARGET" "$REMOTE_MKDIR_CMD" >> "$LOG_FILE" 2>&1
        fi
        
        # Sync user repo — sanity-check local repo before rsync to avoid mirroring corruption
        echo "$(get_timestamp) Syncing user repository to remote..." | tee -a "$LOG_FILE"
        if ! borg list "$USER_REPO" >/dev/null 2>&1; then
            echo "$(get_timestamp) ERROR: Local user repository failed sanity check — skipping rsync to protect remote copy" | tee -a "$LOG_FILE"
            SYNC_FAILED=1
        else
            if [ -n "$REMOTE_BACKUP_PASSWORD" ]; then
                SSHPASS="$REMOTE_BACKUP_PASSWORD" rsync -avz --delete --stats -e "sshpass -e ssh -p $REMOTE_BACKUP_PORT -o StrictHostKeyChecking=no" \
                    "$USER_REPO/" "${REMOTE_BACKUP_SSH_TARGET}:${REMOTE_BACKUP_DIR}/home/$user/" >> "$LOG_FILE" 2>&1
            else
                rsync -avz --delete --stats -e "ssh -p $REMOTE_BACKUP_PORT -o StrictHostKeyChecking=no" \
                    "$USER_REPO/" "${REMOTE_BACKUP_SSH_TARGET}:${REMOTE_BACKUP_DIR}/home/$user/" >> "$LOG_FILE" 2>&1
            fi
            if [ $? -eq 0 ]; then
                echo "$(get_timestamp) User repository synced successfully" | tee -a "$LOG_FILE"
            else
                echo "$(get_timestamp) ERROR: User repository sync failed" | tee -a "$LOG_FILE"
                SYNC_FAILED=1
            fi
        fi
        
        # Sync DB repo
        echo "$(get_timestamp) Syncing database repository to remote..." | tee -a "$LOG_FILE"
        if ! borg list "$DB_REPO" >/dev/null 2>&1; then
            echo "$(get_timestamp) ERROR: Local DB repository failed sanity check — skipping rsync to protect remote copy" | tee -a "$LOG_FILE"
            SYNC_FAILED=1
        else
            if [ -n "$REMOTE_BACKUP_PASSWORD" ]; then
                SSHPASS="$REMOTE_BACKUP_PASSWORD" rsync -avz --delete --stats -e "sshpass -e ssh -p $REMOTE_BACKUP_PORT -o StrictHostKeyChecking=no" \
                    "$DB_REPO/" "${REMOTE_BACKUP_SSH_TARGET}:${REMOTE_BACKUP_DIR}/db/$user/" >> "$LOG_FILE" 2>&1
            else
                rsync -avz --delete --stats -e "ssh -p $REMOTE_BACKUP_PORT -o StrictHostKeyChecking=no" \
                    "$DB_REPO/" "${REMOTE_BACKUP_SSH_TARGET}:${REMOTE_BACKUP_DIR}/db/$user/" >> "$LOG_FILE" 2>&1
            fi
            if [ $? -eq 0 ]; then
                echo "$(get_timestamp) Database repository synced successfully" | tee -a "$LOG_FILE"
            else
                echo "$(get_timestamp) ERROR: Database repository sync failed" | tee -a "$LOG_FILE"
                SYNC_FAILED=1
            fi
        fi
        
        # Sync Vesta repo
        echo "$(get_timestamp) Syncing myVesta config to remote..." | tee -a "$LOG_FILE"
        if ! borg list "$VESTA_REPO" >/dev/null 2>&1; then
            echo "$(get_timestamp) ERROR: Local myVesta repository failed sanity check — skipping rsync to protect remote copy" | tee -a "$LOG_FILE"
            SYNC_FAILED=1
        else
            if [ -n "$REMOTE_BACKUP_PASSWORD" ]; then
                SSHPASS="$REMOTE_BACKUP_PASSWORD" rsync -avz --stats -e "sshpass -e ssh -p $REMOTE_BACKUP_PORT -o StrictHostKeyChecking=no" \
                    "$VESTA_REPO/" "${REMOTE_BACKUP_SSH_TARGET}:${REMOTE_BACKUP_DIR}/vesta/" >> "$LOG_FILE" 2>&1
            else
                rsync -avz --stats -e "ssh -p $REMOTE_BACKUP_PORT -o StrictHostKeyChecking=no" \
                    "$VESTA_REPO/" "${REMOTE_BACKUP_SSH_TARGET}:${REMOTE_BACKUP_DIR}/vesta/" >> "$LOG_FILE" 2>&1
            fi
            if [ $? -eq 0 ]; then
                echo "$(get_timestamp) myVesta config synced successfully" | tee -a "$LOG_FILE"
            else
                echo "$(get_timestamp) ERROR: myVesta config sync failed" | tee -a "$LOG_FILE"
                SYNC_FAILED=1
            fi
        fi
    elif [ "$REMOTE_SYNC_METHOD" = "borg" ]; then
        echo "$(get_timestamp) ========== REMOTE BACKUP (INDEPENDENT BORG) ==========" | tee -a "$LOG_FILE"
        
        echo "$(get_timestamp) Creating remote archive: $REMOTE_USER_REPO::$ARCHIVE_NAME" | tee -a "$LOG_FILE"
        eval borg create \
            $OPTIONS_CREATE \
            $EXCLUDE_ARGS \
            "$REMOTE_USER_REPO::$ARCHIVE_NAME" \
            "$HOME_DIR/$user" \
            2>&1 | tee -a "$LOG_FILE"
        REMOTE_BORG_EXIT=${PIPESTATUS[0]}
        if borg_ok "$REMOTE_BORG_EXIT"; then
            echo "$(get_timestamp) Remote home backup completed successfully" | tee -a "$LOG_FILE"
            echo "$(get_timestamp) Pruning remote home archives..." | tee -a "$LOG_FILE"
            borg prune $OPTIONS_PRUNE "$REMOTE_USER_REPO" 2>&1 | tee -a "$LOG_FILE"
            compact_repo_if_supported "$REMOTE_USER_REPO" >> "$LOG_FILE" 2>&1
        else
            echo "$(get_timestamp) ERROR: Remote home backup failed (exit $REMOTE_BORG_EXIT)" | tee -a "$LOG_FILE"
            SYNC_FAILED=1
        fi
        
        if [ -d "$VESTA_USER_DIR" ]; then
            echo "$(get_timestamp) Creating remote archive: $REMOTE_VESTA_REPO::$VESTA_ARCHIVE_NAME" | tee -a "$LOG_FILE"
            borg create \
                $OPTIONS_CREATE \
                "$REMOTE_VESTA_REPO::$VESTA_ARCHIVE_NAME" \
                "$VESTA_USER_DIR" \
                2>&1 | tee -a "$LOG_FILE"
            REMOTE_BORG_EXIT=${PIPESTATUS[0]}
            if borg_ok "$REMOTE_BORG_EXIT"; then
                echo "$(get_timestamp) Remote myVesta config backup completed successfully" | tee -a "$LOG_FILE"
                borg prune $OPTIONS_PRUNE "$REMOTE_VESTA_REPO" 2>&1 | tee -a "$LOG_FILE"
                compact_repo_if_supported "$REMOTE_VESTA_REPO" >> "$LOG_FILE" 2>&1
            else
                echo "$(get_timestamp) ERROR: Remote myVesta config backup failed (exit $REMOTE_BORG_EXIT)" | tee -a "$LOG_FILE"
                SYNC_FAILED=1
            fi
        fi
    fi
fi

if [ -n "$BACKUP_FAILED" ]; then
    echo "$(get_timestamp) Status: FAILED (see log for details)" | tee -a "$LOG_FILE"
    BACKUP_STATUS="FAILED"
elif [ -n "$SYNC_FAILED" ]; then
    echo "$(get_timestamp) Status: SUCCESS (remote sync FAILED)" | tee -a "$LOG_FILE"
    BACKUP_STATUS="SUCCESS (remote sync FAILED)"
else
    echo "$(get_timestamp) Status: SUCCESS" | tee -a "$LOG_FILE"
    BACKUP_STATUS="SUCCESS"
fi

#----------------------------------------------------------#
#                Notifications                             #
#----------------------------------------------------------#

if [ "$notify" = "yes" ] || [ -n "$NOTIFY_ADMIN_BACKUP" ]; then
    HOST=$(hostname 2>/dev/null || echo "server")
    if [ "$BACKUP_STATUS" = "SUCCESS" ]; then
        SUBJECT="[Borg Backup SUCCESS] $HOST - User $user"
    elif [ "$BACKUP_STATUS" = "SUCCESS (remote sync FAILED)" ]; then
        SUBJECT="[Borg Backup SUCCESS - remote sync FAILED] $HOST - User $user"
    else
        SUBJECT="[Borg Backup FAILED] $HOST - User $user"
    fi
    BODY=""
    BODY="${BODY}============================================\n"
    BODY="${BODY}Borg Backup Report - $(date '+%Y-%m-%d %H:%M:%S')\n"
    BODY="${BODY}Host: $HOST | User: $user\n"
    BODY="${BODY}Status: $BACKUP_STATUS\n"
    BODY="${BODY}============================================\n\n"
    BODY="${BODY}--- Backup Log ---\n"
    BODY="${BODY}$(cat "$LOG_FILE")\n"
    
    if [ "$notify" = "yes" ]; then
        # Notify user
        USER_EMAIL=$(/usr/local/vesta/bin/v-list-user "$user" plain | awk '{print $2}')
        if [ -n "$USER_EMAIL" ]; then
            echo -e "$BODY" | send_notification_stdin "$SUBJECT" "$USER_EMAIL"
        fi
    fi
    
    if [ -n "$NOTIFY_ADMIN_BACKUP" ]; then
        # Notify admin on every run (success or failure)
        echo -e "$BODY" | send_notification_stdin "$SUBJECT" "$NOTIFY_ADMIN_BACKUP"
    fi
fi

#----------------------------------------------------------#
#                Logging                                   #
#----------------------------------------------------------#

log_event "OK" "Backup completed for user $user (status: $BACKUP_STATUS)"

# Exit with appropriate code
if [ -n "$BACKUP_FAILED" ]; then
    exit 1
fi
if [ -n "$SYNC_FAILED" ]; then
    exit 2
fi

exit 0
