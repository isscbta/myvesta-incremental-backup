#!/bin/bash
# info: show backup status for a user
# options: USER [FORMAT]
#
# This command shows the current backup status for a specific user.

#----------------------------------------------------------#
#                Variable & Argument Definition            #
#----------------------------------------------------------#

# Arguments
user=$1
format=${2-shell}

# Source shared functions
if [ -f "/usr/local/vesta/func/borg.sh" ]; then
    source /usr/local/vesta/func/borg.sh
else
    # Try local development path
    SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null && pwd )"
    NEW_BORG_DIR="$(dirname "$SCRIPT_DIR")"
    source "$NEW_BORG_DIR/func/borg.sh"
fi

# Source myVesta environment
source /etc/profile.d/vesta.sh 2>/dev/null || source /etc/profile

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_root
check_borg_installed
source_borg_config

# Check arguments
if [ -z "$user" ]; then
    echo "Usage: v-borg-status USER [FORMAT]"
    echo "Error: USER argument is required"
    exit 1
fi

# Check if user exists
if ! check_user_exists "$user"; then
    echo "Error: User '$user' does not exist"
    exit 1
fi

# Load per-user config
load_user_borg_config "$user" 2>/dev/null

#----------------------------------------------------------#
#                Gather Status Information                  #
#----------------------------------------------------------#

BACKUP_LOCATION_LABEL=$(get_backup_location_label)
BACKUP_LOCATION_DETAIL=$(get_backup_location_detail)

USER_REPO=$(build_borg_repo_path "user" "$user")
DB_REPO=$(build_borg_repo_path "db" "$user")
VESTA_REPO=$(build_borg_repo_path "vesta" "")

LAST_BACKUP=$(get_last_backup_date "$user")
BACKUP_COUNT=$(get_backup_count "$user")
USER_REPO_HEALTH=$(check_repo_health "$USER_REPO")
DB_REPO_HEALTH=$(check_repo_health "$DB_REPO")

# Primary sizes (respect current BACKUP_MODE path — remote uses ssh:// borg info)
USER_REPO_SIZE=$(get_repo_size "$USER_REPO")
DB_REPO_SIZE=$(get_repo_size "$DB_REPO")

# For "both", also measure the other side
LOCAL_USER_REPO_SIZE=0
LOCAL_DB_REPO_SIZE=0
REMOTE_USER_REPO_SIZE=0
REMOTE_DB_REPO_SIZE=0
if [ "$BACKUP_MODE" = "both" ]; then
    LOCAL_USER_REPO_SIZE=$(get_repo_size "$(build_borg_repo_path_mode local user "$user")")
    LOCAL_DB_REPO_SIZE=$(get_repo_size "$(build_borg_repo_path_mode local db "$user")")
    REMOTE_USER_REPO_SIZE=$(get_repo_size "$(build_borg_repo_path_mode remote user "$user")")
    REMOTE_DB_REPO_SIZE=$(get_repo_size "$(build_borg_repo_path_mode remote db "$user")")
elif [ "$BACKUP_MODE" = "remote" ]; then
    REMOTE_USER_REPO_SIZE=$USER_REPO_SIZE
    REMOTE_DB_REPO_SIZE=$DB_REPO_SIZE
else
    LOCAL_USER_REPO_SIZE=$USER_REPO_SIZE
    LOCAL_DB_REPO_SIZE=$DB_REPO_SIZE
fi

# Server disk (always the myVesta host — not Storage Box capacity)
DISK_USAGE=$(get_disk_usage "${BACKUP_DIR:-/}")
DISK_TOTAL=$(echo "$DISK_USAGE" | awk '{print $1}')
DISK_USED=$(echo "$DISK_USAGE" | awk '{print $2}')
DISK_AVAIL=$(echo "$DISK_USAGE" | awk '{print $3}')
DISK_PERCENT=$(echo "$DISK_USAGE" | awk '{print $4}')

#----------------------------------------------------------#
#                Format Output                              #
#----------------------------------------------------------#

case "$format" in
    json)
        echo "{"
        echo "  \"user\": \"$user\","
        echo "  \"backup_mode\": \"$BACKUP_MODE\","
        echo "  \"backup_location\": \"$BACKUP_LOCATION_LABEL\","
        echo "  \"backup_location_detail\": \"$BACKUP_LOCATION_DETAIL\","
        echo "  \"last_backup\": \"$LAST_BACKUP\","
        echo "  \"backup_count\": $BACKUP_COUNT,"
        echo "  \"repository_health\": {"
        echo "    \"user_repo\": \"$USER_REPO_HEALTH\","
        echo "    \"db_repo\": \"$DB_REPO_HEALTH\""
        echo "  },"
        echo "  \"repository_sizes\": {"
        echo "    \"user_repo\": $USER_REPO_SIZE,"
        echo "    \"db_repo\": $DB_REPO_SIZE,"
        echo "    \"local_user_repo\": $LOCAL_USER_REPO_SIZE,"
        echo "    \"local_db_repo\": $LOCAL_DB_REPO_SIZE,"
        echo "    \"remote_user_repo\": $REMOTE_USER_REPO_SIZE,"
        echo "    \"remote_db_repo\": $REMOTE_DB_REPO_SIZE"
        echo "  },"
        echo "  \"server_disk\": {"
        echo "    \"total\": $DISK_TOTAL,"
        echo "    \"used\": $DISK_USED,"
        echo "    \"available\": $DISK_AVAIL,"
        echo "    \"percent\": $DISK_PERCENT"
        echo "  },"
        echo "  \"config\": {"
        echo "    \"enabled\": \"$BORG_BACKUP_ENABLED\","
        echo "    \"web\": \"$BORG_BACKUP_WEB\","
        echo "    \"mail\": \"$BORG_BACKUP_MAIL\","
        echo "    \"db\": \"$BORG_BACKUP_DB\""
        echo "  }"
        echo "}"
        ;;
        
    plain)
        echo -e "USER\tMODE\tLAST_BACKUP\tBACKUP_COUNT\tUSER_REPO_HEALTH\tDB_REPO_HEALTH"
        echo -e "$user\t$BACKUP_MODE\t$LAST_BACKUP\t$BACKUP_COUNT\t$USER_REPO_HEALTH\t$DB_REPO_HEALTH"
        ;;
        
    shell|*)
        echo "Backup Status for User: $user"
        echo "================================"
        echo "Backup location:    $BACKUP_LOCATION_LABEL"
        echo "                    $BACKUP_LOCATION_DETAIL"
        echo "Last Backup:        $LAST_BACKUP"
        echo "Total Archives:     $BACKUP_COUNT"
        echo ""
        echo "Repository Health:"
        echo "  User Repo:        $USER_REPO_HEALTH"
        echo "  DB Repo:          $DB_REPO_HEALTH"
        echo ""
        echo "Repository Sizes (borg deduplicated):"
        if [ "$BACKUP_MODE" = "both" ]; then
            echo "  Local user:       $(format_size $LOCAL_USER_REPO_SIZE)"
            echo "  Local DB:         $(format_size $LOCAL_DB_REPO_SIZE)"
            echo "  Remote user:      $(format_size $REMOTE_USER_REPO_SIZE)"
            echo "  Remote DB:        $(format_size $REMOTE_DB_REPO_SIZE)"
        elif [ "$BACKUP_MODE" = "remote" ]; then
            echo "  Remote user:      $(format_size $USER_REPO_SIZE)"
            echo "  Remote DB:        $(format_size $DB_REPO_SIZE)"
        else
            echo "  Local user:       $(format_size $USER_REPO_SIZE)"
            echo "  Local DB:         $(format_size $DB_REPO_SIZE)"
        fi
        echo ""
        echo "Server Disk (this host — not remote backup storage):"
        echo "  Total:            $(format_size $DISK_TOTAL)"
        echo "  Used:             $(format_size $DISK_USED)"
        echo "  Available:        $(format_size $DISK_AVAIL)"
        echo "  Usage:            $DISK_PERCENT%"
        echo ""
        echo "Backup Config:"
        echo "  Enabled:          $BORG_BACKUP_ENABLED"
        echo "  Web:              $BORG_BACKUP_WEB"
        echo "  Mail:             $BORG_BACKUP_MAIL"
        echo "  DB:               $BORG_BACKUP_DB"
        ;;
esac

exit 0
