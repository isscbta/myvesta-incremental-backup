#!/bin/bash
# info: update borg backup system to latest version
# options: [--config] [--version TAG]
#
# Updates Borg backup scripts and function library from GitHub.
# Preserves your borg.conf by default. Use --config to also update config (backup created first).
#
# Usage: v-borg-update [--config] [--version TAG]

#----------------------------------------------------------#
#                Color Definitions                         #
#----------------------------------------------------------#

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

#----------------------------------------------------------#
#                Helper Functions                          #
#----------------------------------------------------------#

print_success() {
    echo -e "${GREEN}✓${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

print_info() {
    echo -e "${YELLOW}→${NC} $1"
}

print_header() {
    echo ""
    echo "=========================================="
    echo "$1"
    echo "=========================================="
    echo ""
}

#----------------------------------------------------------#
#                Configuration                             #
#----------------------------------------------------------#

GITHUB_REPO="isscbta/myvesta-incremental-backup"

SCRIPTS=(
    "v-borg-backup-system"
    "v-borg-backup-user"
    "v-borg-backup-users"
    "v-borg-delete-backup"
    "v-borg-list-backups"
    "v-borg-restore-user"
    "v-borg-status"
    "v-borg-report"
    "v-borg-report-global"
    "v-borg-checkup"
    "v-borg-restore-checkup"
    "v-borg-backup-prune"
    "v-borg-install"
    "v-borg-update"
)

#----------------------------------------------------------#
#                Verifications                             #
#----------------------------------------------------------#

if [ "$(id -u)" != "0" ]; then
    print_error "This script must be run as root"
    exit 1
fi

if [ ! -d "/usr/local/vesta" ]; then
    print_error "myVesta is not installed. Run v-borg-install first."
    exit 1
fi

if [ ! -f "/usr/local/vesta/func/borg.sh" ]; then
    print_error "Borg backup is not installed. Run v-borg-install first."
    exit 1
fi

UPDATE_CONFIG="no"
REF=""
while [ $# -gt 0 ]; do
    case "$1" in
        --config|-c)
            UPDATE_CONFIG="yes"
            shift
            ;;
        --version|-v)
            if [ -z "${2:-}" ]; then
                print_error "--version requires a tag argument"
                exit 1
            fi
            REF="$2"
            shift 2
            ;;
        *)
            print_error "Unknown option: $1"
            echo "Usage: v-borg-update [--config] [--version TAG]"
            exit 1
            ;;
    esac
done

# Resolve ref: explicit tag > latest GitHub release > main
if [ -z "$REF" ]; then
    API_URL="https://api.github.com/repos/${GITHUB_REPO}/releases/latest"
    REF=$(wget -qO- "$API_URL" 2>/dev/null | grep -o '"tag_name": *"[^"]*"' | head -1 | cut -d'"' -f4)
    if [ -z "$REF" ]; then
        REF="main"
        print_info "No release tag found, updating from main branch"
    fi
fi

GITHUB_RAW_URL="https://raw.githubusercontent.com/${GITHUB_REPO}/${REF}"

#----------------------------------------------------------#
#                Update                                    #
#----------------------------------------------------------#

print_header "myVesta Borg Backup - Update"

print_info "Updating to: $REF"
print_info "Source: $GITHUB_RAW_URL"
echo ""

STAGING_DIR=$(mktemp -d /tmp/v-borg-update.XXXXXX)
trap 'rm -rf "$STAGING_DIR"' EXIT

#----------------------------------------------------------#
#                Phase 1: Download to staging              #
#----------------------------------------------------------#

print_header "Phase 1: Downloading"

print_info "Downloading borg.sh..."
if ! wget -q -O "$STAGING_DIR/borg.sh" "${GITHUB_RAW_URL}/func/borg.sh" 2>/dev/null; then
    print_error "Failed to download borg.sh"
    print_error "No changes were made to installed files"
    exit 1
fi
print_success "borg.sh downloaded"

for script in "${SCRIPTS[@]}"; do
    print_info "Downloading ${script}..."
    if ! wget -q -O "$STAGING_DIR/$script" "${GITHUB_RAW_URL}/bin/${script}" 2>/dev/null; then
        print_error "Failed to download: $script"
        print_error "No changes were made to installed files"
        exit 1
    fi
    print_success "  $script downloaded"
done

if [ "$UPDATE_CONFIG" = "yes" ]; then
    print_info "Downloading borg.conf..."
    if ! wget -q -O "$STAGING_DIR/borg.conf" "${GITHUB_RAW_URL}/conf/borg.conf" 2>/dev/null; then
        print_error "Failed to download borg.conf"
        print_error "No changes were made to installed files"
        exit 1
    fi
    print_success "borg.conf downloaded"
fi

#----------------------------------------------------------#
#                Phase 2: Verify staged files              #
#----------------------------------------------------------#

print_header "Phase 2: Verifying"

verify_staged_file() {
    local file="$1"
    local label="$2"
    local check_shebang="${3:-no}"

    if [ ! -s "$file" ]; then
        print_error "Verify failed ($label): file is missing or empty"
        return 1
    fi
    if ! bash -n "$file" 2>/dev/null; then
        print_error "Verify failed ($label): bash -n syntax check failed"
        return 1
    fi
    if [ "$check_shebang" = "yes" ]; then
        local shebang
        shebang=$(head -c 2 "$file" 2>/dev/null)
        if [ "$shebang" != "#!" ]; then
            print_error "Verify failed ($label): missing shebang (possible HTML error page)"
            return 1
        fi
    fi
    return 0
}

if ! verify_staged_file "$STAGING_DIR/borg.sh" "borg.sh" "no"; then
    print_error "No changes were made to installed files"
    exit 1
fi
print_success "borg.sh verified"

for script in "${SCRIPTS[@]}"; do
    if ! verify_staged_file "$STAGING_DIR/$script" "$script" "yes"; then
        print_error "No changes were made to installed files"
        exit 1
    fi
    print_success "  $script verified"
done

if [ "$UPDATE_CONFIG" = "yes" ]; then
    if ! verify_staged_file "$STAGING_DIR/borg.conf" "borg.conf" "no"; then
        print_error "No changes were made to installed files"
        exit 1
    fi
    print_success "borg.conf verified"
fi

#----------------------------------------------------------#
#                Phase 3: Install                          #
#----------------------------------------------------------#

print_header "Phase 3: Installing"

print_info "Installing borg.sh..."
install -m 644 "$STAGING_DIR/borg.sh" "/usr/local/vesta/func/borg.sh"
print_success "func/borg.sh installed"

for script in "${SCRIPTS[@]}"; do
    print_info "Installing ${script}..."
    install -m 755 "$STAGING_DIR/$script" "/usr/local/vesta/bin/$script"
    print_success "  $script installed"
done

if [ "$UPDATE_CONFIG" = "yes" ]; then
    print_header "Updating Configuration"
    if [ -f "/usr/local/vesta/conf/borg.conf" ]; then
        BACKUP_FILE="/usr/local/vesta/conf/borg.conf.bak.$(date +%Y%m%d_%H%M%S)"
        cp /usr/local/vesta/conf/borg.conf "$BACKUP_FILE"
        print_success "Backup created: $BACKUP_FILE"
    fi
    print_info "Installing borg.conf..."
    install -m 600 -o root -g root "$STAGING_DIR/borg.conf" "/usr/local/vesta/conf/borg.conf"
    print_success "borg.conf installed (restore from backup if needed)"
else
    print_info "Config preserved (use --config to update borg.conf)"
fi

#----------------------------------------------------------#
#                Done                                      #
#----------------------------------------------------------#

print_header "Update Complete!"
print_success "Scripts and function library updated to: $REF"
echo ""
